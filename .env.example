# ============================================
# Delve - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys.
#
# LLM — Google Gemini Free Tier Engine
# ──────────────────────────────────────────
# Get a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL for Google Gemini REST API (v1beta)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Primary workhorse model (Free Tier: 15 RPM / 250k TPM / 500 RPD)
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
LLM_MODEL=gemini-3.1-flash-lite

# Per-request timeout in seconds
LLM_TIMEOUT_SECONDS=120

# Tavily Web Search API (optional but recommended)
# Get a key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# Optional Configuration
# ============================================
# Retrieval tuning
MAX_SEARCH_QUERIES=4
MAX_SOURCE_RESULTS_PER_QUERY=4
SEMANTIC_SCHOLAR_MAX_RETRIES=3
SEMANTIC_SCHOLAR_BASE_BACKOFF_SECONDS=2.0
MAX_DEBATE_ROUNDS=1
STRICT_SYNTHESIS_MODE=false

# Contact email sent to Crossref for polite-pool access. Leave blank to omit.
CROSSREF_CONTACT_EMAIL=

# Server settings
HOST=0.0.0.0
PORT=8000

# ============================================
# Hosted public-beta deployment (Supabase + Upstash)
# ============================================
# Set APP_ENVIRONMENT=production only after every value below is configured.
APP_ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173

# Supabase: never expose SERVICE_ROLE_KEY to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional for legacy HS256 Supabase projects. New projects use JWKS automatically.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=delve-documents
# Random 32+ character server-only secret used for short-lived WebSocket tickets.
WS_TICKET_SECRET=
# Random server-only secret forwarded by QStash to the internal job endpoint.
JOB_DISPATCH_SECRET=

# Upstash QStash wakes the Render API to run durable jobs. Keep all values server-only.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUBLIC_API_BASE_URL=

# Upstash Redis REST is used for distributed rate limits and job concurrency limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Conservative free-tier public-beta limits.
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_RESEARCH_JOBS_PER_DAY=15
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_PAGES=100
MAX_EXTRACTED_TEXT_BYTES=5242880
MAX_DOCUMENTS_PER_USER=20
MAX_LLM_CALLS_PER_JOB=30
MAX_LLM_CALLS_IN_FLIGHT=4
